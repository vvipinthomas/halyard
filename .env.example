# Required: 32 random bytes, base64. `npm run setup` (or `npm start`) fills this in for you.
# Or generate one yourself:  openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: require this token to create the first admin (recommended on any public URL)
SETUP_TOKEN=
# Optional: PBKDF2 work factor (Workers caps at 100000; Docker may go higher, e.g. 600000)
PBKDF2_ITERATIONS=100000
# Optional: login attempts per IP per 15 minutes (default 20)
LOGIN_RATE_PER_15MIN=20
# Optional: requests per user per minute to the frontier LLM proxy
LLM_RATE_PER_MIN=60
# Software Factory tick interval in seconds (0 disables the background loop)
FACTORY_TICK_SECONDS=300
# Set true only behind exactly one reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=false
# Docker only: allow calls to private/local network addresses (Ollama, local MCP)
ALLOW_PRIVATE_NETWORK=false
