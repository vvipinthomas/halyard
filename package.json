{
  "name": "halyard",
  "version": "1.5.0",
  "description": "Open-source agent & harness workbench: build, orchestrate, measure and govern AI agents.",
  "main": "src/node.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prestart": "node scripts/setup.mjs",
    "start": "node src/node.js",
    "predev": "node scripts/setup.mjs",
    "dev": "node --watch src/node.js",
    "screenshots": "node scripts/screenshots.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "cf:migrate": "wrangler d1 migrations apply halyard --remote",
    "cf:deploy": "wrangler deploy",
    "cf:dev": "wrangler dev"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "qrcode-generator": "^1.5.2",
    "wrangler": "^4.156.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "orchestration",
    "llm",
    "cloudflare-workers",
    "agent-harness"
  ]
}